{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decision",
    "confidence",
    "summary",
    "publicMessage",
    "evidence",
    "duplicateCandidates",
    "questions",
    "riskLevel",
    "riskReasons",
    "affectedPaths",
    "implementationSteps",
    "testPlan"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "decision": {
      "type": "string",
      "enum": [
        "already_implemented",
        "fixed_unreleased",
        "duplicate_requirement",
        "duplicate_bug",
        "regression",
        "usage_or_configuration",
        "needs_info",
        "cannot_reproduce",
        "valid_bug",
        "valid_feature",
        "security_sensitive",
        "out_of_scope"
      ]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "summary": { "type": "string", "minLength": 2, "maxLength": 2000 },
    "publicMessage": { "type": "string", "minLength": 2, "maxLength": 3000 },
    "evidence": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference", "summary"],
        "properties": {
          "kind": { "type": "string", "enum": ["code", "test", "issue", "pull_request", "commit", "release"] },
          "reference": { "type": "string", "minLength": 1, "maxLength": 500 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "duplicateCandidates": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issueNumber", "url", "reason"],
        "properties": {
          "issueNumber": { "type": "integer", "minimum": 1 },
          "url": { "type": "string", "pattern": "^https://github\\.com/", "maxLength": 500 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "questions": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 500 } },
    "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "forbidden"] },
    "riskReasons": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 500 } },
    "affectedPaths": { "type": "array", "maxItems": 80, "items": { "type": "string", "maxLength": 300 } },
    "implementationSteps": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 1000 } },
    "testPlan": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 1000 } }
  }
}
