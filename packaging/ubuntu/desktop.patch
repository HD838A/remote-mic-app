+#[cfg(target_os="linux")]
+fn ubuntu_file_dialog(save: bool, ext: &str) -> Result<Option<PathBuf>, String> {
+    use std::os::unix::ffi::OsStringExt;
+    let mut dialog = std::process::Command::new("zenity");
+    dialog.arg("--file-selection").arg(format!("--file-filter=*.{ext}"));
+    if save { dialog.arg("--save").arg(format!("--filename=SayAll.{ext}")); }
+    let result = dialog.output().map_err(|e| e.to_string())?;
+    match result.status.code() {
+        Some(0) => {
+            let mut bytes = result.stdout;
+            if bytes.last() == Some(&b'\n') { bytes.pop(); }
+            Ok(Some(std::ffi::OsString::from_vec(bytes).into()))
+        }
+        Some(1) => Ok(None),
+        _ => Err("Ubuntu file chooser failed".into()),
+    }
+}
