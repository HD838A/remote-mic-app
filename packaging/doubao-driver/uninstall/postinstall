#!/bin/zsh
set -euo pipefail
source "${0:A:h}/driver-naming.zsh"

TARGET_VOLUME="${3:-/}"
DRIVER_DESTINATION="${TARGET_VOLUME%/}/Library/Audio/Plug-Ins/HAL/MiRemoteV2ch.driver"
DRIVER_PLIST="$DRIVER_DESTINATION/Contents/Info.plist"
# 历史版本兼容：这些路径与 Bundle ID 是所有已发布 App 的卸载身份。
# 变更或新增身份时必须保留旧值，并同步
# scripts/test-installer-architecture-guard.sh 与 Testing/MacInstallerUninstaller.md。
APP_DESTINATIONS=(
  "${TARGET_VOLUME%/}/Applications/SayAll.app"
  "${TARGET_VOLUME%/}/Applications/Remote Mic.app"
  "${TARGET_VOLUME%/}/Applications/无线麦.app"
)
APP_LABELS=("SayAll.app" "Remote Mic.app" "无线麦.app")
BUNDLE_IDENTIFIER="com.hd838a.RemoteMic"
DRIVER_BUNDLE_IDENTIFIER="com.hd838a.MiRemoteV2ch"
HCI_SERVICE_LABEL="com.hd838a.SayAll.AppleRemoteHCIService"
HCI_SERVICE_DESTINATION="${TARGET_VOLUME%/}/Library/PrivilegedHelperTools/$HCI_SERVICE_LABEL"
HCI_SERVICE_PLIST="${TARGET_VOLUME%/}/Library/LaunchDaemons/$HCI_SERVICE_LABEL.plist"
HCI_SERVICE_STATE="${TARGET_VOLUME%/}/Library/Application Support/RemoteMic/AppleRemoteHCI"
SIRI_REMOTE_PACKAGE_ID="com.hd838a.RemoteMic.siri-remote"
UNINSTALL_TOKEN="$(/bin/date -u +%Y%m%dT%H%M%SZ)-$$"
ITEM_SOURCES=()
ITEM_LABELS=()
ITEM_KINDS=()
ITEM_DESTINATIONS=()
MOVED_APP_PATHS=()
MOVED_COUNT=0
DRIVER_MOVED=0
HCI_SERVICE_OWNED=0
HCI_SERVICE_UNOWNED=0
NAMING_QUEUED=0
SIRI_RECEIPT_PRESENT=0
SIRI_RECEIPT_FORGOTTEN=0
SIRI_RECEIPT_FAILED=0
DOCK_TILE_REMOVED=0
DOCK_TILE_FAILED=0
CONSOLE_USER=""
CONSOLE_UID=""
CONSOLE_HOME=""

uses_chinese_locale() {
  local locale="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"
  [[ "$locale" == zh* ]]
}

installer_message() {
  if uses_chinese_locale; then
    print "$1"
  else
    print "$2"
  fi
}

item_bundle_identifier() {
  /usr/bin/plutil -extract CFBundleIdentifier raw -o - "$1" 2>/dev/null || true
}

queue_owned_app() {
  local app_path="$1"
  local app_label="$2"
  local app_plist="$app_path/Contents/Info.plist"

  if [[ ! -e "$app_path" && ! -L "$app_path" ]]; then
    return
  fi
  if [[ ! -f "$app_plist" ]] || \
     [[ "$(item_bundle_identifier "$app_plist")" != "$BUNDLE_IDENTIFIER" ]]; then
    installer_message \
      "$app_label 不属于无线麦SayAll.app，卸载器已保留它不作处理。" \
      "$app_label does not belong to SayAll and was left untouched."
    return
  fi
  ITEM_SOURCES+=("$app_path")
  ITEM_LABELS+=("$app_label")
  ITEM_KINDS+=("app")
}

queue_owned_driver() {
  if [[ ! -e "$DRIVER_DESTINATION" && ! -L "$DRIVER_DESTINATION" ]]; then
    return
  fi
  if [[ ! -f "$DRIVER_PLIST" ]] || \
     [[ "$(item_bundle_identifier "$DRIVER_PLIST")" != "$DRIVER_BUNDLE_IDENTIFIER" ]]; then
    installer_message \
      "MiRemoteV2ch.driver 无法确认为无线麦兼容麦克风，卸载器已保留它不作处理。" \
      "MiRemoteV2ch.driver could not be verified as the SayAll compatibility microphone and was left untouched."
    return
  fi
  ITEM_SOURCES+=("$DRIVER_DESTINATION")
  ITEM_LABELS+=("MiRemoteV2ch.driver")
  ITEM_KINDS+=("driver")
}

queue_owned_driver_naming() {
  local directory recorded
  NAMING_DIRECTORY="${TARGET_VOLUME%/}/Library/Application Support/RemoteMic/DriverNaming"
  if [[ ! -e "$NAMING_DIRECTORY" && ! -L "$NAMING_DIRECTORY" ]]; then
    print 'DRIVER_NAMING phase=uninstall_observed recorded=none'
    return
  fi
  for directory in "${TARGET_VOLUME%/}/Library" \
    "${TARGET_VOLUME%/}/Library/Application Support" "${NAMING_DIRECTORY:h}" "$NAMING_DIRECTORY"; do
    if ! driver_naming_safe_directory "$directory"; then
      print -u2 'DRIVER_NAMING phase=uninstall_blocked result=failed reason=unsafe_state_directory'
      installer_message "卸载已停止：麦克风名称记录目录不可信。现有安装项已保留。" \
        "Uninstallation stopped: the microphone naming directory is unsafe. Existing installation items were kept." >&2
      return 2
    fi
  done
  if ! recorded="$(driver_naming_record)"; then
    print -u2 'DRIVER_NAMING phase=uninstall_blocked result=failed reason=invalid_state'
    installer_message "卸载已停止：麦克风名称记录无法确认归属。现有安装项已保留。" \
      "Uninstallation stopped: the microphone naming records could not be verified. Existing installation items were kept." >&2
    return 2
  fi
  print -r -- "DRIVER_NAMING phase=uninstall_observed recorded=$recorded"
  ITEM_SOURCES+=("$NAMING_DIRECTORY")
  ITEM_LABELS+=("SayAllDriverNaming.state")
  ITEM_KINDS+=("driver_naming")
  NAMING_QUEUED=1
}

queue_owned_hci_service() {
  if [[ -e "$HCI_SERVICE_DESTINATION" || -L "$HCI_SERVICE_DESTINATION" ]]; then
    if [[ ! -x "$HCI_SERVICE_DESTINATION" ]] || \
       ! /usr/bin/codesign --verify --strict "$HCI_SERVICE_DESTINATION" >/dev/null 2>&1 || \
       [[ "$(/usr/bin/codesign -dvv "$HCI_SERVICE_DESTINATION" 2>&1 | \
         /usr/bin/sed -n 's/^Identifier=//p')" != "$HCI_SERVICE_LABEL" ]]; then
      HCI_SERVICE_UNOWNED=1
      installer_message \
        "Apple Remote 系统服务无法确认为无线麦组件，卸载器已保留它。" \
        "The Apple Remote system service could not be verified as a SayAll component and was left untouched."
    else
      HCI_SERVICE_OWNED=1
      ITEM_SOURCES+=("$HCI_SERVICE_DESTINATION")
      ITEM_LABELS+=("SayAllAppleRemoteHCIService.helper")
      ITEM_KINDS+=("hci_service")
    fi
  fi

  if [[ -e "$HCI_SERVICE_PLIST" || -L "$HCI_SERVICE_PLIST" ]]; then
    if [[ ! -f "$HCI_SERVICE_PLIST" ]] || \
       [[ "$(/usr/bin/plutil -extract Label raw -o - "$HCI_SERVICE_PLIST" 2>/dev/null || true)" != \
         "$HCI_SERVICE_LABEL" ]]; then
      HCI_SERVICE_UNOWNED=1
      installer_message \
        "Apple Remote 系统服务配置无法确认归属，卸载器已保留它。" \
        "The Apple Remote service configuration could not be verified and was left untouched."
    else
      ITEM_SOURCES+=("$HCI_SERVICE_PLIST")
      ITEM_LABELS+=("$HCI_SERVICE_LABEL.plist")
      ITEM_KINDS+=("hci_plist")
    fi
  fi

  if [[ "$HCI_SERVICE_OWNED" -eq 1 && -d "$HCI_SERVICE_STATE" && \
        ! -L "$HCI_SERVICE_STATE" ]]; then
    ITEM_SOURCES+=("$HCI_SERVICE_STATE")
    ITEM_LABELS+=("AppleRemoteHCI.state")
    ITEM_KINDS+=("hci_state")
  fi
}

prepare_trash_root() {
  local console_user console_uid user_home trash_created=0

  console_user="$(/usr/bin/stat -f '%Su' /dev/console)"
  if [[ "$console_user" != "root" && "$console_user" != "loginwindow" ]] && \
     console_uid="$(/usr/bin/id -u "$console_user" 2>/dev/null)"; then
    user_home="$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory \
      2>/dev/null | /usr/bin/sed -n 's/^NFSHomeDirectory: //p')"
  else
    console_uid=0
    user_home=""
  fi

  if [[ "$TARGET_VOLUME" == "/" && "$user_home" == /* && "$user_home" != "/" && \
        "$user_home" != *'/../'* && "$user_home" != *'/..' ]]; then
    TRASH_ROOT="${TARGET_VOLUME%/}$user_home/.Trash"
    CONSOLE_USER="$console_user"
    CONSOLE_UID="$console_uid"
    CONSOLE_HOME="$user_home"
  else
    TRASH_ROOT="${TARGET_VOLUME%/}/.Trashes/$console_uid"
  fi
  if [[ "$TRASH_ROOT" != /* || "$TRASH_ROOT" == "/" || "$console_uid" != <-> ]]; then
    return 1
  fi
  if [[ ! -d "$TRASH_ROOT" ]]; then
    /bin/mkdir -p -- "$TRASH_ROOT" || return 1
    trash_created=1
  fi
  if [[ "$trash_created" -eq 1 ]]; then
    /usr/sbin/chown "$console_uid" "$TRASH_ROOT" || return 1
    /bin/chmod 700 "$TRASH_ROOT" || return 1
  fi
}

trash_destination_for_item() {
  local label="$1"
  local stem extension candidate counter=0

  case "$label" in
    *.app) stem="${label%.app}"; extension=".app" ;;
    *.driver) stem="${label%.driver}"; extension=".driver" ;;
    *.helper) stem="${label%.helper}"; extension=".helper" ;;
    *.plist) stem="${label%.plist}"; extension=".plist" ;;
    *.state) stem="${label%.state}"; extension=".state" ;;
    *) return 1 ;;
  esac
  candidate="$TRASH_ROOT/$stem (uninstalled $UNINSTALL_TOKEN)$extension"
  while [[ -e "$candidate" || -L "$candidate" ]]; do
    counter=$((counter + 1))
    candidate="$TRASH_ROOT/$stem (uninstalled $UNINSTALL_TOKEN-$counter)$extension"
  done
  print -r -- "$candidate"
}

rollback_moved_items() {
  local index
  for (( index=MOVED_COUNT; index>=1; index-- )); do
    if ! /bin/mv -n -- "${ITEM_DESTINATIONS[$index]}" "${ITEM_SOURCES[$index]}"; then
      installer_message \
        "无法自动恢复 ${ITEM_LABELS[$index]}；它仍保留在废纸篓 ${ITEM_DESTINATIONS[$index]} 中。" \
        "${ITEM_LABELS[$index]} could not be restored automatically and remains in Trash at ${ITEM_DESTINATIONS[$index]}." >&2
    fi
  done
}

run_as_console_user() {
  /usr/bin/sudo -H -u "$CONSOLE_USER" "$@"
}

decode_dock_url() {
  local url="$1"
  [[ "$url" == file://* ]] || return 1
  url="${url#file://}"
  url="${url#localhost}"
  url="${url%/}"
  print -r -- "$(printf '%b' "${url//\%/\\x}")"
}

remove_dock_indices() {
  if (( $# == 0 )); then
    /bin/cat
    return 0
  fi
  local index="$1"
  shift
  /usr/bin/plutil -remove "persistent-apps.$index" -o - - | remove_dock_indices "$@"
}

# Only the current console user's fixed Dock entries are touched. The whole
# exported domain is imported back after removing matching array entries, so
# unrelated Dock settings and other users' preferences stay unchanged.
cleanup_dock_tiles() {
  local dock_plist count index url decoded source
  local -a remove_indices

  if [[ "$TARGET_VOLUME" != "/" ]]; then
    print 'DOCK_TILE phase=cleanup result=skipped reason=non_boot_volume'
    return 0
  fi
  if [[ "${#MOVED_APP_PATHS[@]}" -eq 0 ]]; then
    print 'DOCK_TILE phase=cleanup result=skipped reason=no_moved_app'
    return 0
  fi
  if [[ -z "$CONSOLE_USER" || -z "$CONSOLE_HOME" || "$CONSOLE_UID" != <-> ]]; then
    print 'DOCK_TILE phase=cleanup result=skipped reason=console_user_unavailable'
    return 0
  fi
  if [[ ! -x /usr/bin/sudo ]]; then
    print 'DOCK_TILE phase=cleanup result=skipped reason=console_user_helper_unavailable'
    return 0
  fi
  if ! dock_plist="$(run_as_console_user /usr/bin/defaults export com.apple.dock - 2>/dev/null)"; then
    print 'DOCK_TILE phase=cleanup result=skipped reason=preferences_unavailable'
    return 0
  fi
  if ! count="$(print -r -- "$dock_plist" | \
      /usr/bin/plutil -extract persistent-apps raw -o - - 2>/dev/null)"; then
    print 'DOCK_TILE phase=cleanup result=skipped reason=no_persistent_apps'
    return 0
  fi
  if [[ "$count" != <-> || "$count" -eq 0 ]]; then
    print 'DOCK_TILE phase=cleanup result=skipped reason=no_persistent_apps'
    return 0
  fi

  for (( index=count-1; index>=0; index-- )); do
    url="$(print -r -- "$dock_plist" | /usr/bin/plutil -extract \
      "persistent-apps.$index.tile-data.file-data._CFURLString" raw -o - - \
      2>/dev/null || true)"
    [[ -n "$url" ]] || continue
    if ! decoded="$(decode_dock_url "$url")"; then
      continue
    fi
    for source in "${MOVED_APP_PATHS[@]}"; do
      if [[ "${decoded%/}" == "${source%/}" ]]; then
        remove_indices+=("$index")
        break
      fi
    done
  done

  if [[ "${#remove_indices[@]}" -eq 0 ]]; then
    print 'DOCK_TILE phase=cleanup result=no_match'
    return 0
  fi
  if print -r -- "$dock_plist" | remove_dock_indices "${remove_indices[@]}" | \
      run_as_console_user /usr/bin/defaults import com.apple.dock - >/dev/null 2>&1; then
    DOCK_TILE_REMOVED="${#remove_indices[@]}"
    print "DOCK_TILE phase=cleanup result=removed count=$DOCK_TILE_REMOVED"
    run_as_console_user /usr/bin/killall Dock >/dev/null 2>&1 || true
    return 0
  fi
  DOCK_TILE_FAILED=1
  print -u2 'DOCK_TILE phase=cleanup result=failed reason=preferences_write_failed'
  return 1
}

siri_receipt_exists() {
  /usr/sbin/pkgutil --volume "$TARGET_VOLUME" --pkg-info "$SIRI_REMOTE_PACKAGE_ID" \
    >/dev/null 2>&1
}

# The installer uses this receipt to preselect the optional Siri Remote
# component, and onboarding uses it as the installed marker. Forget it only
# when no unverified HCI helper or LaunchDaemon was left behind.
cleanup_siri_receipt() {
  if ! siri_receipt_exists; then
    print 'SIRI_RECEIPT phase=cleanup result=skipped reason=absent'
    return 0
  fi
  SIRI_RECEIPT_PRESENT=1
  if [[ "$HCI_SERVICE_UNOWNED" -eq 1 ]]; then
    print 'SIRI_RECEIPT phase=cleanup result=skipped reason=unowned_component_present'
    return 0
  fi
  if /usr/sbin/pkgutil --volume "$TARGET_VOLUME" --forget "$SIRI_REMOTE_PACKAGE_ID" \
      >/dev/null 2>&1; then
    SIRI_RECEIPT_FORGOTTEN=1
    print 'SIRI_RECEIPT phase=cleanup result=forgotten'
    return 0
  fi
  SIRI_RECEIPT_FAILED=1
  print -u2 'SIRI_RECEIPT phase=cleanup result=failed reason=forget_failed'
  return 1
}

for (( index=1; index<=${#APP_DESTINATIONS[@]}; index++ )); do
  queue_owned_app "${APP_DESTINATIONS[$index]}" "${APP_LABELS[$index]}"
done
queue_owned_driver
queue_owned_hci_service
queue_owned_driver_naming

if [[ "${#ITEM_SOURCES[@]}" -eq 0 ]]; then
  if ! cleanup_siri_receipt; then
    installer_message \
      "未发现可卸载的安装项，但未能清除 Siri Remote 安装记录。" \
      "No installation items were found, but the Siri Remote installation metadata could not be cleared." >&2
    exit 2
  fi
  if [[ "$SIRI_RECEIPT_FORGOTTEN" -eq 1 ]]; then
    installer_message \
      "未发现可卸载的安装项；已清除残留的 Siri Remote 安装记录。" \
      "No installation items were found; stale Siri Remote installation metadata was cleared."
  else
    installer_message \
      "未发现可安全卸载的无线麦SayAll.app 或兼容麦克风。" \
      "No SayAll app or compatible microphone installation that could be safely uninstalled was found."
  fi
  exit 0
fi

if ! prepare_trash_root; then
  print -u2 'DRIVER_NAMING phase=uninstall_blocked result=failed reason=trash_unavailable'
  installer_message \
    "卸载已停止：无法安全使用废纸篓，现有 App 和兼容麦克风均已保留。" \
    "Uninstallation stopped because Trash could not be used safely. The existing app and compatibility microphone were left intact." >&2
  exit 2
fi

for label in "${ITEM_LABELS[@]}"; do
  if [[ "$label" == *.app && "$TARGET_VOLUME" == "/" ]]; then
    /usr/bin/pkill -x RemoteMic 2>/dev/null || true
    break
  fi
done

if [[ "$TARGET_VOLUME" == "/" ]]; then
  /bin/launchctl bootout "system/$HCI_SERVICE_LABEL" >/dev/null 2>&1 || true
  if [[ "$HCI_SERVICE_OWNED" -eq 1 ]]; then
    "$HCI_SERVICE_DESTINATION" --restore >/dev/null 2>&1 || true
  fi
fi

for (( index=1; index<=${#ITEM_SOURCES[@]}; index++ )); do
  ITEM_DESTINATIONS+=("$(trash_destination_for_item "${ITEM_LABELS[$index]}")")
  if /bin/mv -n -- "${ITEM_SOURCES[$index]}" "${ITEM_DESTINATIONS[$index]}" && \
     [[ ! -e "${ITEM_SOURCES[$index]}" && ! -L "${ITEM_SOURCES[$index]}" ]] && \
     [[ -e "${ITEM_DESTINATIONS[$index]}" || -L "${ITEM_DESTINATIONS[$index]}" ]]; then
    MOVED_COUNT="$index"
    if [[ "${ITEM_KINDS[$index]}" == "app" ]]; then
      MOVED_APP_PATHS+=("${ITEM_SOURCES[$index]}" "${ITEM_DESTINATIONS[$index]}")
    fi
    [[ "${ITEM_KINDS[$index]}" == "driver" ]] && DRIVER_MOVED=1
  else
    installer_message \
      "卸载 ${ITEM_LABELS[$index]} 失败；正在恢复本次已移动的项目。" \
      "Failed to uninstall ${ITEM_LABELS[$index]}; restoring items moved during this run." >&2
    rollback_moved_items
    print -u2 'DRIVER_NAMING phase=uninstall_rollback result=failed reason=move_failed'
    exit 2
  fi
done

if [[ "$NAMING_QUEUED" -eq 1 ]]; then
  print 'DRIVER_NAMING phase=uninstall_completed result=verified records=trashed'
fi

cleanup_dock_tiles || DOCK_TILE_FAILED=1
cleanup_siri_receipt || SIRI_RECEIPT_FAILED=1

# The recognized items are already in Trash, so a failed audio-service restart
# must not turn a successful uninstall into an installer error, and a real
# failure must be reported honestly instead of swallowed by `|| true`.
restart_audio_service() {
  if ! /usr/bin/pgrep -qx coreaudiod; then
    installer_message \
      "系统音频服务当前未运行，无需重启；驱动移除即刻生效。" \
      "The system audio service is not running; no restart was needed and the driver removal takes effect immediately."
  elif /usr/bin/killall coreaudiod; then
    installer_message \
      "已重启系统音频服务。" \
      "Restarted the system audio service."
  else
    installer_message \
      "驱动已移除，但重启系统音频服务失败；请重启 Mac 完成卸载。" \
      "The driver was removed, but the system audio service could not be restarted; restart your Mac to finish."
  fi
}

if [[ "$DRIVER_MOVED" -eq 1 && "$TARGET_VOLUME" == "/" ]]; then
  restart_audio_service
fi
if [[ "$SIRI_RECEIPT_FORGOTTEN" -eq 1 ]]; then
  installer_message \
    "已清除 Siri Remote 组件安装记录。" \
    "Siri Remote installation metadata was cleared."
fi
if [[ "$DOCK_TILE_REMOVED" -gt 0 ]]; then
  installer_message \
    "已移除 $DOCK_TILE_REMOVED 个指向被卸载 App 的 Dock 固定项。" \
    "Removed $DOCK_TILE_REMOVED Dock item(s) that pointed to the uninstalled app."
fi
installer_message \
  "已将无线麦SayAll.app 的已识别安装项移到废纸篓，需要时可恢复；BlackHole、App 本地设置、日志和用户数据未被修改。" \
  "Recognized SayAll installation items were moved to Trash and can be restored. BlackHole, app local settings, logs, and user data were not changed."
if [[ "$SIRI_RECEIPT_FAILED" -eq 1 || "$DOCK_TILE_FAILED" -eq 1 ]]; then
  installer_message \
    "安装项已移到废纸篓，但部分安装记录或 Dock 固定项未能清理；请手动移除残留项。" \
    "Installation items were moved to Trash, but some installation metadata or Dock items could not be cleaned up; remove any remaining items manually." >&2
  exit 2
fi
