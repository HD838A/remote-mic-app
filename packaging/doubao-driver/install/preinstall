#!/bin/zsh
set -euo pipefail

TARGET_VOLUME="${3:-/}"
SCRIPT_DIR="${0:A:h}"
RELEASE_CONFIG="$SCRIPT_DIR/release-variant.plist"
DESTINATION="${TARGET_VOLUME%/}/Library/Audio/Plug-Ins/HAL/MiRemoteV2ch.driver"
PLIST="$DESTINATION/Contents/Info.plist"
APP_DESTINATION="${TARGET_VOLUME%/}/Applications/Remote Mic.app"
APP_PLIST="$APP_DESTINATION/Contents/Info.plist"
LEGACY_APP_DESTINATION="${TARGET_VOLUME%/}/Applications/无线麦.app"
LEGACY_APP_PLIST="$LEGACY_APP_DESTINATION/Contents/Info.plist"

uses_chinese_locale() {
  local locale="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"
  [[ "$locale" == zh* ]]
}

installer_message() {
  if uses_chinese_locale; then
    print "$1"
  else
    print "$2"
  fi
}

test -f "$RELEASE_CONFIG"
EXPECTED_ARCHITECTURE="$(/usr/bin/plutil -extract ExpectedArchitecture raw -o - "$RELEASE_CONFIG")"
MINIMUM_SYSTEM_MAJOR="$(/usr/bin/plutil -extract MinimumSystemMajor raw -o - "$RELEASE_CONFIG")"
PACKAGE_BUILD="$(/usr/bin/plutil -extract PackageBuild raw -o - "$RELEASE_CONFIG")"
CURRENT_ARCHITECTURE="$(/usr/bin/uname -m)"
CURRENT_SYSTEM_MAJOR="$(/usr/bin/sw_vers -productVersion | /usr/bin/cut -d. -f1)"
[[ "$PACKAGE_BUILD" == <-> ]]
if [[ "$CURRENT_ARCHITECTURE" != "$EXPECTED_ARCHITECTURE" ]]; then
  installer_message \
    "未安装：此安装包适用于 $EXPECTED_ARCHITECTURE Mac，当前机器是 $CURRENT_ARCHITECTURE。" \
    "Installation stopped: this package is for $EXPECTED_ARCHITECTURE Macs, but this Mac is $CURRENT_ARCHITECTURE." >&2
  exit 2
fi
if [[ "$CURRENT_SYSTEM_MAJOR" -lt "$MINIMUM_SYSTEM_MAJOR" ]]; then
  installer_message \
    "未安装：此安装包需要 macOS $MINIMUM_SYSTEM_MAJOR 或更高版本。" \
    "Installation stopped: this package requires macOS $MINIMUM_SYSTEM_MAJOR or later." >&2
  exit 2
fi

if [[ -e "$DESTINATION" ]]; then
  if [[ ! -f "$PLIST" ]] || \
     [[ "$(/usr/bin/plutil -extract CFBundleIdentifier raw -o - "$PLIST" 2>/dev/null || true)" != "com.hd838a.MiRemoteV2ch" ]]; then
    installer_message \
      "未安装：目标路径存在无法识别的音频驱动 $DESTINATION" \
      "Installation stopped: an unrecognized audio driver exists at $DESTINATION." >&2
    installer_message \
      "为避免覆盖其他软件，安装器已停止。" \
      "To avoid overwriting other software, the installer has stopped." >&2
    exit 2
  fi
  installer_message \
    "检测到已有 MiRemoteV 2ch；安装后会检查它是否需要更新。" \
    "An existing MiRemoteV 2ch was found and will be checked before any update."
fi

if [[ -e "$APP_DESTINATION" || -L "$APP_DESTINATION" ]]; then
  if [[ ! -f "$APP_PLIST" ]] || \
     [[ "$(/usr/bin/plutil -extract CFBundleIdentifier raw -o - "$APP_PLIST" 2>/dev/null || true)" != "com.hd838a.RemoteMic" ]]; then
    installer_message \
      "未安装：目标路径存在不属于 Remote Mic 的应用 $APP_DESTINATION" \
      "Installation stopped: an app not owned by Remote Mic exists at $APP_DESTINATION." >&2
    installer_message \
      "为避免覆盖其他软件，安装器已停止。" \
      "To avoid overwriting other software, the installer has stopped." >&2
    exit 2
  fi
  INSTALLED_BUILD="$(/usr/bin/plutil -extract CFBundleVersion raw -o - "$APP_PLIST" 2>/dev/null || true)"
  if [[ "$INSTALLED_BUILD" == <-> && "$INSTALLED_BUILD" -gt "$PACKAGE_BUILD" ]]; then
    installer_message \
      "未安装：当前 Remote Mic 的构建号 $INSTALLED_BUILD 高于此测试包的构建号 $PACKAGE_BUILD。" \
      "Installation stopped: the installed Remote Mic build $INSTALLED_BUILD is newer than this test package build $PACKAGE_BUILD." >&2
    installer_message \
      "现有应用已完整保留。请改用更新的安装包。" \
      "The existing app was left intact. Use a newer installer." >&2
    exit 2
  fi
  installer_message \
    "检测到已有 Remote Mic.app；安装器会以原子方式更新它。" \
    "An existing Remote Mic.app was found and will be updated atomically."
fi

if [[ -e "$LEGACY_APP_DESTINATION" || -L "$LEGACY_APP_DESTINATION" ]]; then
  if [[ -f "$LEGACY_APP_PLIST" ]] && \
     [[ "$(/usr/bin/plutil -extract CFBundleIdentifier raw -o - "$LEGACY_APP_PLIST" 2>/dev/null || true)" == "com.hd838a.RemoteMic" ]]; then
    /usr/bin/pkill -x RemoteMic 2>/dev/null || true
    /bin/rm -rf -- "$LEGACY_APP_DESTINATION"
    installer_message \
      "已移除旧版“无线麦.app”，准备安装新版本。" \
      "Removed the legacy Remote Mic app before installing the new version."
  else
    installer_message \
      "旧中文应用路径不属于 Remote Mic，安装器将保留它不作处理。" \
      "The legacy Chinese app path does not belong to Remote Mic and will be left untouched."
  fi
fi
